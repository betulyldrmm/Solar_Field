# Copy to .env (never commit .env)
SFS_DATA_MODE=simulation          # simulation | hardware (never mixed)
SFS_RUN_SIMULATOR=true            # live synthetic data in simulation mode
SFS_DATA_DIR=../data
SFS_HOST=127.0.0.1                # localhost only; set 0.0.0.0 only on a trusted LAN
SFS_PORT=8000
SFS_API_TOKEN=                    # empty -> PUT /api/config disabled
SFS_CORS_ORIGINS=http://localhost:5173
SFS_LATITUDE=41.735               # site coordinates (default: Kırklareli)
SFS_LONGITUDE=27.225
SFS_TIMEZONE=Europe/Istanbul
SFS_BATTERY_SERIES_CELLS=1        # 1 = 1S (3.0-4.2 V), 3 = 3S (9.0-12.6 V) — set after CN3791 check
SFS_MIN_FREE_DISK_MB=200
