[Unit]
Description=Solar Field Station Web Dashboard & UNO Q Router Bridge
After=network.target arduino-router.service
Wants=arduino-router.service

[Service]
Type=simple
User=arduino
Group=arduino
WorkingDirectory=/home/arduino/Solar_Field/backend
Environment="SFS_DATA_DIR=/home/arduino/Solar_Field/backend/data"
Environment="SFS_DATA_MODE=hardware"
Environment="SFS_HOST=0.0.0.0"
Environment="SFS_PORT=80"
Environment="SFS_API_TOKEN=vegas123"
Environment="SFS_CAPTIVE_PORTAL_URL="
Environment="SFS_BT_PAN_IP=10.44.0.1"
Environment="SFS_FRONTEND_DIST=/home/arduino/Solar_Field/frontend/dist"
Environment="SFS_CORS_ORIGINS=http://10.44.0.1,http://solar.field,http://uno-q.local,http://localhost:5173"
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/home/arduino/Solar_Field/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 80
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
